SERVER_URL=http://localhost:3000
WORKER_TOKEN=replace-with-backend-worker-token
WORKER_ID=gpu-worker-local
JOB_POLL_INTERVAL_MS=2000

# Use only for local contract checks. Production should use real Qwen/WAN credentials.
GPU_WORKER_SIMULATE=false
GPU_WORKER_GENERATION_MODE=wan

QWEN_BASE_URL=http://qwen.internal:8001
QWEN_API_TOKEN=replace-with-qwen-internal-token
QWEN_TIMEOUT_MS=45000

WAN_API_BASE_URL=http://wan.internal:8002
WAN_API_TOKEN=replace-with-wan-internal-token
WAN_GENERATE_PATH=/v1/sprites/generate
WAN_TIMEOUT_MS=90000
IMAGE_STORAGE_DIR=../backend/generated-assets
IMAGE_PUBLIC_BASE_URL=http://localhost:3000/generated-assets

# Optional compatibility mode for a single internal generation gateway.
# Set GPU_WORKER_GENERATION_MODE=gateway to use these values instead of Qwen/WAN.
GENERATION_GATEWAY_URL=http://generation-gateway.internal:8188
GENERATION_GATEWAY_PATH=/v2/sprite-jobs/generate
GENERATION_GATEWAY_TIMEOUT_MS=600000
