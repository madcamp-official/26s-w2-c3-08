# 5080 워커 환경 — 이 파일을 gpu-worker/.env 로 복사해서 값 채움 (index.ts가 자동 로드).
# 워커 연결은 전부 아웃바운드(NAT 안전).

# 백엔드 큐 (공개 게임 서버 호스트 — sunboy7594 아님, -game 붙음)
SERVER_URL=https://sunboy7594-game.madcamp-kaist.org

# 로컬 ComfyUI (5080에서 실행 중이어야 함)
COMFYUI_URL=http://127.0.0.1:8188

# 큐가 빌 때 폴링 간격(ms)
POLL_INTERVAL_MS=3000

# --- 선택: 워커 인증 (백엔드 WORKER_TOKEN을 설정한 경우에만, 값 일치 필요) ---
# WORKER_TOKEN=

# --- 선택: 실제 LLM 외형 (미설정 시 스텁으로 동작 — 3090/VPN 없이 ComfyUI 검증 가능) ---
# 우선순위: ANTHROPIC_API_KEY > QWEN_GATEWAY_URL > 스텁.
# 2026-07-16 실측: 3090 Qwen2-VL-7B가 저작권 캐릭터명 유출 + 환각 디테일을 뽑는 걸 확인 —
# Claude Haiku 4.5가 이미지를 훨씬 정확히 봄(호출당 ~$0.004, 동아리 규모엔 무시할 비용).
# ANTHROPIC_API_KEY=
# CLAUDE_VISION_MODEL=claude-haiku-4-5

# 3090 게이트웨이 :8001은 방화벽에 막혀 직접 불가 → SSH 로컬포워드 터널 후 127.0.0.1로.
#   ssh -N -L 8001:127.0.0.1:8001 root@172.10.5.138   (VPN 연결 상태에서)
# QWEN_GATEWAY_URL=http://127.0.0.1:8001
# QWEN_INTERNAL_TOKEN=<3090 /opt/qwen-prompt-server/.env 의 QWEN_API_TOKEN>
