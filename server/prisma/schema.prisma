// =============================================================================
// 멀티플레이 UGC 플랫포머 — Prisma 스키마 v1 초안 (2026-07-11)
// 서버 레포 구조 미정 → 팀원 전달용 docs/ 초안. 서버 레포로 옮긴 뒤 마이그레이션.
//
// 작성 원칙:
// 1. 확정된 3개 모델(User, Asset, AssetSprite)만 활성 코드 — v1 마이그레이션 대상.
// 2. 미확정 모델 5개(Room, RoomMember, Line, Placement, RaceResult)는 주석 블록 + 사유.
// 3. enum 대신 String — 값 추가 시 마이그레이션 없이 확장. 허용 값은 모델 위 주석에 나열.
// 4. attrs JSON의 형식 강제는 DB가 아니라 서버 Zod. 카테고리별 옵션(shared/schemas). 몬스터 런타임 AI는
//    rules: RuleSpec[](shared/behavior 규칙엔진)로 attrs에 포함 — 이건 "동작"이지 "생성 애니"가 아님.
// 5. 생성 파이프라인 다리: deriveActions(category, attrs) → AssetSprite(action별 1행) → GPU가 sheetUrl 채움.
//    (생성 애니 = idle/walk/onair/fly/climb/attack. 나머지 동작은 코드가 스프라이트를 움직여 표현.)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 활성 모델 (2026-07-10 확정)
// =============================================================================

// ── User ─────────────────────────────────────────────────
// nickname:        표시용, 중복 허용, 설정에서 변경 가능
// token:           재접속 식별용, 클라이언트 localStorage 저장
//                  (MySQL에는 uuid 타입이 없어 Char(36)으로 저장)
// deviceLinkCode:  기기 연동 단축 코드 — 5분 유효, 1회 소비 복제 모델
// equippedSkillId: 확장 예약 — 추후 Asset 참조 예정, 지금은 컬럼만 예약
model User {
  id                  BigInt    @id @default(autoincrement())
  nickname            String    @db.VarChar(20)
  token               String    @unique @db.Char(36)
  avatarAssetId       BigInt?                                  // NULL = 기본 아바타(졸라맨)
  avatarAsset         Asset?    @relation("EquippedAvatar", fields: [avatarAssetId], references: [id])
  deviceLinkCode      String?
  deviceLinkExpiresAt DateTime?
  equippedSkillId     BigInt?                                  // 예약 (관계 미연결)
  createdAt           DateTime  @default(now())

  createdAssets Asset[]   @relation("CreatedAssets")           // 이 유저가 제작한 에셋
  mapLines      MapLine[]                                       // 이 유저가 만든 라인
}

// ── Asset ────────────────────────────────────────────────
// category:     avatar | platform | obstacle | monster | background | item
//               (item은 isSystem 전용 — 유저 제작 불가)
// colliderType: rect | slope | none(배경)
// slopeDir:     floor-asc(◢) | floor-desc(◣) | ceil-desc(◥) | ceil-asc(◤)
//               — 1차 구현은 바닥 2종, 천장 2종은 예약
// status:       draft → generating → ready | failed
// attrs:        파츠 옵션 세트(JSON). behavior 카테고리(monster/block)는 조건→행동 규칙
//               rules: RuleSpec[] 를 포함(shared/behavior). 그 외 vuln/hp/faces/properties 등도 여기.
//               형식·검증 = 서버 Zod (behavior 레지스트리의 등록 조건·행동명 기준). DB는 그릇만.
//               런타임은 이 rules를 그대로 규칙엔진에 먹인다(별도 변환 없음).
// hitboxHPx:    아바타 전용 키(px) — 산출 높이를 {1.1,1.3,1.5}타일 중 최근접으로 스냅(§66).
//               (기존 1.35~1.95 연속 클램프 → 3단계 이산으로 변경)
// remixOfId:    [에셋 불러오기] 파생 시 원작 추적 — 수정해야 저장 가능 (그대로 복제 불가)
model Asset {
  id                 BigInt   @id @default(autoincrement())
  creatorId          BigInt?                                   // NULL = 시스템 에셋
  creator            User?    @relation("CreatedAssets", fields: [creatorId], references: [id])
  isSystem           Boolean  @default(false)                  // 기본 제공(졸라맨·스타터·아이템 2종)
  category           String
  name               String   @db.VarChar(30)                  // 이름 필수 확정
  description        String?                                   // 유저 입력 — LLM 프롬프트 원료
  attrs              Json
  colliderType       String   @default("rect")
  slopeDir           String?                                   // colliderType='slope'일 때만
  widthCells         Int?     @db.SmallInt                     // 가로 타일 수 — 아바타는 NULL(1타일 고정)
  heightCells        Int?     @db.SmallInt                     // 세로 타일 수
  hitboxHPx          Int?     @db.SmallInt
  sourceType         String   @default("drawn")                // "drawn"(캔버스, 투명 보장) | "uploaded"(임의 파일 — 배경 분리 필요할 수 있음)
  sourceImageUrl     String                                    // 파이프라인 입력 계약: 투명 배경 PNG (drawn=캔버스 원본, uploaded=정규화본 우선)
  rawSourceUrl       String?                                   // uploaded 원본 보존(재처리·디버깅용). drawn이면 NULL
  normSourceUrl      String?                                   // 배경 분리된 투명 PNG — 서버(flood-fill 즉시 성공) 또는 워커(AI 매팅)가 채움. 후속 잡·재생성이 재사용
  projectileImageUrl String?                                   // 발사체 정지 이미지 또는 기본 탄 — 회전은 코드 처리
  remixOfId          BigInt?
  remixOf            Asset?   @relation("Remixes", fields: [remixOfId], references: [id])
  remixes            Asset[]  @relation("Remixes")
  status             String   @default("draft")
  isPublic           Boolean  @default(true)                   // 현재 비공개 미지원 — 유저 에셋 전부 공용 풀 대상. 컬럼은 향후 확장용 보존(2026-07-14)
  createdAt          DateTime @default(now())

  sprites         AssetSprite[]                                // 액션별 스프라이트 시트
  equippedByUsers User[]             @relation("EquippedAvatar") // 이 에셋을 아바타로 장착한 유저
  linePlacements  MapLinePlacement[]                           // 이 에셋이 배치된 라인 배치들(삭제 Restrict)

  @@index([creatorId])
  @@index([isSystem])
  @@index([category])
}

// ── AssetSprite ──────────────────────────────────────────
// AssetSprite = 스프라이트 행 + 생성 잡 큐를 겸함 (한 액션 = 한 행 = 한 잡).
// action:   생성 애니 액션명 — deriveActions(category, attrs)의 출력 하나당 한 행.
//           idle | walk | onair | fly | climb | attack (shared/actions catalog). 확장 = catalog+derive 한 줄.
//           (윈드업·피격·죽음 등은 코드가 스프라이트를 움직여 표현 — 생성 대상 아님.)
// status:   queued → generating → ready | failed   (generating = 워커가 claim한 상태)
// 큐 = pull (§8): 5080 ComfyUI 워커가 queued 잡을 폴링→claim(claimedAt·generating)→시트 업로드→ready.
//   프롬프트는 백엔드가 적재 시 3090 LLM으로 만들어 prompt에 실어둠(워커는 그림+액션+prompt만 사용).
//   claimedAt 오래된 generating = 스테일 → 재큐잉(워커 죽음 대비).
// priority: 첫 생성 높음 / 재생성 낮음 (GPU 유휴 시 처리).
// 재생성은 새 행 추가가 아니라 기존 행 갱신 (assetId+action 유니크)
model AssetSprite {
  id          BigInt    @id @default(autoincrement())
  assetId     BigInt
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      String                                           // = shared/actions 액션명 (deriveActions 출력)
  prompt      String?   @db.Text                               // 3090 LLM 생성 액션 프롬프트 (백엔드가 적재 시)
  sheetUrl    String?                                          // 생성 완료(ready) 전 NULL — 워커가 업로드
  frameCount  Int?      @db.SmallInt
  frameW      Int?      @db.SmallInt
  frameH      Int?      @db.SmallInt
  status      String    @default("queued")
  claimedAt   DateTime?                                        // 5080 워커가 집어간 시각 (스테일 잡 회수)
  attempts    Int       @default(0) @db.SmallInt               // 재시도 횟수 (실패 상한용)
  errorMsg    String?                                          // 실패 사유 (디버깅)
  lastRegenAt DateTime?                                        // 재생성 쿨타임(액션별 5분) 계산용
  priority    Int       @default(0) @db.SmallInt
  createdAt   DateTime  @default(now())

  @@unique([assetId, action])
  @@index([status, priority])                                  // 워커 폴링: queued를 우선순위순으로
}

// ── MapLine ──────────────────────────────────────────────
// 한 플레이어가 제작·테스트한 라인(맵 세그먼트). 게임 종료 후 랜덤 병합 대상.
// 저장 시점: 테스트 성공 시에만 기록/갱신(testPassedAt). 실패 라인은 맵에 안 쓰임.
// 재사용: isPublic이면 "라인 카테고리"로 남이 가져다 씀(추후).
// 세로 크기 = 전역 상수라 라인마다 저장 안 함. 병합맵은 런타임 일회성(미저장).
model MapLine {
  id           BigInt   @id @default(autoincrement())
  creatorId    BigInt?
  creator      User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  name         String?                                          // 재사용 브라우징용(선택)
  tileLength   Int      @db.SmallInt                            // 시작~끝깃발 거리(유동, 상한은 앱 상수)
  startFlagX   Int      @db.SmallInt
  startFlagY   Int      @db.SmallInt
  endFlagX     Int      @db.SmallInt
  endFlagY     Int      @db.SmallInt
  testPassedAt DateTime?                                        // 테스트 성공 시각. NULL=미완=사용 불가
  isPublic     Boolean  @default(false)                        // 라인 재사용 허용
  sourceRoomId String?                                          // 어느 방에서 만들었는지(출처, 선택)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  placements MapLinePlacement[]

  @@index([creatorId])
  @@index([isPublic, testPassedAt])                            // 재사용 가능한(공개+완료) 라인 조회
}

// ── MapLinePlacement ─────────────────────────────────────
// 라인에 배치된 에셋 1개. 라인 로컬 타일좌표(1타일 스냅). 회전·상하반전 없음(flipX만).
// endX/endY = patrol/ride 이동 에셋의 끝점(핸들). 정적이면 NULL.
// asset 삭제는 Restrict — 라인이 참조 중인 에셋은 하드삭제 차단(무결성 보호).
model MapLinePlacement {
  id      BigInt @id @default(autoincrement())
  lineId  BigInt
  line    MapLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  assetId BigInt
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  x       Int     @db.SmallInt
  y       Int     @db.SmallInt
  flipX   Boolean @default(false)                              // 좌우반전 (상하·회전 없음)
  endX    Int?    @db.SmallInt                                 // patrol/ride 끝점, 정적이면 NULL
  endY    Int?    @db.SmallInt

  @@index([lineId])
  @@index([assetId])
}

// =============================================================================
// 게임 진행 모델 (2026-07-14 활성화 — Room/RoomMember/RaceResult)
// =============================================================================
// (구 Line/Placement 초안은 위 MapLine/MapLinePlacement로 대체됨)

// ── Room ── 로비 목록 + 영구 기록. 실시간 상태는 Colyseus 메모리가 원본(2026-07-14 확정).
// status: lobby → building(15s 프리뷰+3분) → racing → finished. String이라 페이즈 추가 자유.
// hostId/userId 등은 scalar(관계 미연결) — 기록 테이블이라 가볍게.
model Room {
  id             BigInt   @id @default(autoincrement())
  code           String   @unique                            // 초대 코드
  name           String?                                     // 미지정 시 "OO님의 방"
  hostId         BigInt                                       // 방장 User id
  isPublic       Boolean  @default(true)
  passwordHash   String?                                      // 비밀방 비번 해시
  maxPlayers     Int      @db.SmallInt
  status         String   @default("lobby")
  lineCount      Int?     @db.SmallInt                        // 경기 시작 시 확정 — 게임시간=lineCount×40초
  phaseStartedAt DateTime?                                    // 로비 카드 진행 경과 계산용
  createdAt      DateTime @default(now())

  members RoomMember[]
  results RaceResult[]
}

// ── RoomMember ──
model RoomMember {
  roomId     BigInt
  room       Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     BigInt
  finalOrder Int?    @db.SmallInt                             // 라인 병합 순서
  canBuild   Boolean @default(true)                           // 난입 시 남은 제작시간<1분이면 false
  lineId     BigInt?                                          // → MapLine (scalar 링크)

  @@id([roomId, userId])
}

// ── RaceResult ── 결과 화면(F)·순위 기록
model RaceResult {
  roomId   BigInt
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   BigInt
  finishMs Int?                                               // 완주 ms, 미완=NULL
  finalX   Int?                                               // 미완 시 도달 거리(거리순 순위)
  rank     Int  @db.SmallInt                                  // 1/2/3 = 금은동

  @@id([roomId, userId])
}

// =============================================================================
// 다음 확정 대기 항목
// =============================================================================
// - 커스텀 스킬 관계 연결 (User.equippedSkillId → Asset)
// - 마이그레이션: MapLine·Room·RoomMember·RaceResult 모델 추가 완료, VM 반영은 VPN 시 (2026-07-14)
// =============================================================================
