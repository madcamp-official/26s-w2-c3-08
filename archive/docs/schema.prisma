// =============================================================================
// 멀티플레이 UGC 플랫포머 — Prisma 스키마 v1 초안 (2026-07-11)
// =============================================================================
//
// 이 파일은 서버 레포 구조가 미정인 상태에서 팀원 전달용으로 docs/에 두는
// 초안입니다. 실제 서버 레포에 옮긴 뒤 마이그레이션을 수행하시기 바랍니다.
//
// 작성 원칙:
// 1. 확정된 3개 모델(User, Asset, AssetSprite)만 활성 코드로 작성합니다.
//    → v1 마이그레이션 대상은 이 3개뿐입니다.
// 2. 미확정 모델(Room, RoomMember, Line, Placement, RaceResult)은 전체를
//    주석 처리한 블록으로 포함하며, 각각 미확정 사유를 명시합니다.
//    (참고용이며 마이그레이션되지 않습니다. 논의 확정 후 활성화합니다.)
// 3. enum 대신 String을 사용합니다. 카테고리·상태 값 추가 시 마이그레이션
//    없이 확장하기 위한 확정 결정입니다. 허용 값은 /// 주석으로 나열합니다.
// 4. 검증 원칙: attrs JSONB의 형식은 DB가 아니라 서버 Zod 스키마가
//    강제합니다. (형식 정의는 docs/asset-attributes.md 기준)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 활성 모델 (2026-07-10 확정)
// =============================================================================

model User {
  id BigInt @id @default(autoincrement())

  /// 표시용 닉네임입니다. 중복을 허용하며 설정에서 변경할 수 있습니다.
  nickname String @db.VarChar(20)

  /// 재접속 식별용 토큰입니다. 클라이언트 localStorage에 저장됩니다.
  token String @unique @db.Uuid

  /// 장착 아바타입니다. NULL이면 기본 아바타(졸라맨)를 사용합니다.
  avatarAssetId BigInt?
  avatarAsset   Asset?  @relation("EquippedAvatar", fields: [avatarAssetId], references: [id])

  /// 기기 연동 단축 코드입니다. 5분 유효, 1회 소비되는 복제 모델입니다.
  deviceLinkCode      String?
  deviceLinkExpiresAt DateTime?

  /// 확장 예약: 커스텀 스킬입니다. 추후 assets 행을 참조할 예정이며,
  /// 지금은 관계를 연결하지 않고 컬럼만 예약해 둡니다.
  equippedSkillId BigInt?

  createdAt DateTime @default(now())

  /// 이 유저가 제작한 에셋 목록입니다.
  createdAssets Asset[] @relation("CreatedAssets")
}

model Asset {
  id BigInt @id @default(autoincrement())

  /// 제작자입니다. NULL 허용: isSystem 기본 제공 에셋은 제작자가 없습니다.
  creatorId BigInt?
  creator   User?   @relation("CreatedAssets", fields: [creatorId], references: [id])

  /// 기본 제공 에셋(졸라맨·스타터 에셋·아이템 2종) 여부입니다.
  isSystem Boolean @default(false)

  /// 허용 값: 'avatar' | 'platform' | 'obstacle' | 'monster' | 'background' | 'item'
  /// ('item'은 isSystem 전용이며 유저 제작이 불가합니다.)
  category String

  /// 에셋 이름입니다. 필수입니다. (이름 필수 확정)
  name String @db.VarChar(30)

  /// 유저가 입력한 설명입니다. LLM 프롬프트 원료로 사용됩니다.
  description String?

  /// 카테고리별 속성입니다. 형식은 docs/asset-attributes.md를 따르며,
  /// 강제는 DB가 아니라 서버 Zod 스키마가 담당합니다.
  attrs Json

  /// 허용 값: 'rect' | 'slope' | 'none'(배경)
  colliderType String @default("rect")

  /// colliderType='slope'일 때의 경사 방향입니다.
  /// 허용 값: 'floor-asc'(◢) | 'floor-desc'(◣) | 'ceil-desc'(◥) | 'ceil-asc'(◤)
  /// 구현 1차는 바닥 2종이며, 천장 2종은 예약입니다.
  slopeDir String?

  /// 에셋 가로 크기(타일)입니다. 아바타는 NULL(가로 1타일 고정)입니다.
  widthCells Int? @db.SmallInt

  /// 에셋 세로 크기(타일)입니다.
  heightCells Int? @db.SmallInt

  /// 아바타 전용 키(px)입니다. 알파 bbox 높이를
  /// 83~125px(1.3~1.95타일)로 클램프한 값입니다.
  hitboxHPx Int? @db.SmallInt

  /// 그림판 원본 이미지 URL입니다. (투명 배경, 별도 업로드 없음)
  sourceImageUrl String

  /// 발사체 정지 이미지(보조 캔버스에서 제작) 또는 기본 탄 URL입니다.
  /// AI 생성은 없으며 회전은 코드로 처리합니다.
  projectileImageUrl String?

  /// [에셋 불러오기]로 파생된 경우 원작을 추적합니다.
  /// 불러온 뒤 수정해야 저장할 수 있습니다. (그대로 복제 불가)
  remixOfId BigInt?
  remixOf   Asset?  @relation("Remixes", fields: [remixOfId], references: [id])
  remixes   Asset[] @relation("Remixes")

  /// 허용 값: 'draft' → 'generating' → 'ready' | 'failed'
  status String @default("draft")

  /// 다른 유저가 불러오기 할 수 있는지 여부입니다.
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())

  /// 액션별 스프라이트 시트 목록입니다.
  sprites AssetSprite[]

  /// 이 에셋을 아바타로 장착한 유저 목록입니다. (역방향 관계)
  equippedByUsers User[] @relation("EquippedAvatar")

  @@index([creatorId])
  @@index([isSystem])
  @@index([category])
}

model AssetSprite {
  id BigInt @id @default(autoincrement())

  assetId BigInt
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// 허용 값: 'idle' | 'walk' | 'onair'
  /// 액션 세트는 카테고리+옵션이 자동 결정합니다.
  action String

  /// 스프라이트 시트 URL입니다. 생성 완료 전에는 NULL입니다.
  sheetUrl   String?
  frameCount Int?    @db.SmallInt
  frameW     Int?    @db.SmallInt
  frameH     Int?    @db.SmallInt

  /// 허용 값: 'queued' → 'generating' → 'ready' | 'failed'
  status String @default("queued")

  /// 재생성 쿨타임(액션별 5분) 계산용 마지막 재생성 시각입니다.
  lastRegenAt DateTime?

  /// 잡 우선순위입니다. 첫 생성은 높음, 재생성은 낮음(GPU 유휴 시 처리)입니다.
  priority Int @default(0) @db.SmallInt

  createdAt DateTime @default(now())

  /// 재생성은 새 행 추가가 아니라 기존 행 갱신으로 처리합니다.
  @@unique([assetId, action])
}

