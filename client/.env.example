# Frontend V2 production-facing mode.
# Copy to client/.env.production for deployment and keep real deployment files out of Git.
VITE_DATA_MODE=remote
VITE_REALTIME_MODE=remote

# Optional. Leave unset when the deployed frontend and backend share the same origin.
# VITE_SOCKET_IO_URL=https://relay.example.com

# Development/preview proxy only. Production REST calls use the deployed origin.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Development only, for additional Vite hosts.
# VITE_ALLOWED_HOSTS=relay.example.com,10.0.0.12
