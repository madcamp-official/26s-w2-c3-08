{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "smoke": "node scripts/frontend-smoke.mjs",
    "tokens:generate": "node ../scripts/generate-design-tokens.mjs",
    "tokens:check": "node ../scripts/generate-design-tokens.mjs --check && node tests/design-tokens.test.mjs",
    "primitives:check": "node tests/primitives.test.mjs",
    "core:check": "node tests/core-components.test.mjs",
    "shells:check": "node tests/shell-components.test.mjs",
    "studio:check": "node tests/studio-components.test.mjs",
    "login:check": "node tests/login-screen.test.mjs && node tests/login-controller.test.mjs",
    "main:check": "node tests/main-settings-screen.test.mjs && node tests/main-settings-controller.test.mjs",
    "warehouse:check": "node tests/warehouse-screen.test.mjs && node tests/warehouse-controller.test.mjs",
    "avatar-studio:check": "node tests/avatar-studio-controller.test.mjs",
    "routes:check": "node tests/prototype-router.test.mjs",
    "flow:check": "node tests/full-v2-flow.test.mjs && node tests/remote-v2-flow.test.mjs",
    "lobby-room:check": "node tests/prototype-router.test.mjs && node tests/lobby-room-controller.test.mjs && node tests/remote-room-port.test.mjs",
    "asset-studio:check": "node tests/asset-studio-controller.test.mjs",
    "game:check": "node tests/game-shell-bridge.test.mjs && node tests/game-controller-flow.test.mjs && node tests/remote-game-room-port.test.mjs",
    "realtime:check": "node tests/realtime-adapters.test.mjs",
    "launcher:check": "node tests/launcher-visual-audit.test.mjs",
    "browser-env:check": "node tests/playwright-browser-env.test.mjs",
    "test:launcher-screenshots": "playwright test --config playwright.launcher.config.ts",
    "test:lobby-room": "playwright test --config playwright.lobby-room.config.ts",
    "test:remote-v2-browser": "playwright test --config playwright.remote-v2.config.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "test:studio-game-screenshots": "playwright test --config playwright.studio-game.config.ts",
    "test:drawing-browser": "playwright test --config playwright.drawing.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "phaser": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-sketch-canvas": "^8.0.0",
    "socket.io-client": "4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
